+    /// <summary>Adds a comment to an issue.</summary>
+    [HttpPost("Issues/{issueId:int}/Comments")]
+    public async Task<IActionResult> CommentIssue(
+        [FromRoute] int issueId,
+        [FromBody] JsonElement request,
+        CancellationToken cancellationToken)
+    {
+        if (issueId <= 0
+            || request.ValueKind != JsonValueKind.Object
+             || !request.TryGetProperty("message", out var messageValue)
+            || messageValue.ValueKind != JsonValueKind.String
+            || string.IsNullOrWhiteSpace(messageValue.GetString()))
+        {
+            return this.BadRequest(new { message = "A valid issue ID and comment are required." });
+        }
+
+        var userId = await this.ResolveAuthenticatedSeerrUserIdAsync(cancellationToken).ConfigureAwait(false);
+        if (!userId.HasValue)
+        {
+            return this.StatusCode(StatusCodes.Status403Forbidden, new { message = "This Jellyfin user is not linked to Seerr." });
+        }
+
+        if (!await this.HasSeerrPermissionAsync(userId.Value, 4194304 | 1048576, cancellationToken).ConfigureAwait(false))
+        {
+            return this.StatusCode(StatusCodes.Status403Forbidden, new { message = "Seerr CREATE_ISSUES permission is required to comment." });
+        }
+
+        var payload = new Dictionary<string, object> { ["message"] = messageValue.GetString()!.Trim() };
+        return await this.ProxyAsync(
+            HttpMethod.Post,
+            $"/issue/{issueId.ToString(CultureInfo.InvariantCulture)}/comment",
+            payload,
+            cancellationToken,
+            userId.Value).ConfigureAwait(false);
+    }
