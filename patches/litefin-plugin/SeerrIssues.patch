+    /// <summary>Resolves or reopens an issue. Only issue managers may change its status.</summary>
+    [HttpPost("Issues/{issueId:int}/Status/{status}")]
+    public async Task<IActionResult> UpdateIssueStatus(
+        [FromRoute] int issueId,
+        [FromRoute] string status,
+        CancellationToken cancellationToken)
+    {
+        if (issueId <= 0 || (!status.Equals("open", StringComparison.OrdinalIgnoreCase)
+            && !status.Equals("resolved", StringComparison.OrdinalIgnoreCase)))
+        {
+            return this.BadRequest(new { message = "A valid issue ID and status (open or resolved) are required." });
+        }
+
+        var userId = await this.ResolveAuthenticatedSeerrUserIdAsync(cancellationToken).ConfigureAwait(false);
+        if (!userId.HasValue)
+        {
+            return this.StatusCode(StatusCodes.Status403Forbidden, new { message = "This Jellyfin user is not linked to Seerr." });
+        }
+
+        const int manageIssues = 1048576;
+        if (!await this.HasSeerrPermissionAsync(userId.Value, manageIssues, cancellationToken).ConfigureAwait(false))
+        {
+            return this.StatusCode(StatusCodes.Status403Forbidden, new { message = "Seerr MANAGE_ISSUES permission is required." });
+        }
+
+        return await this.ProxyAsync(
+            HttpMethod.Post,
+            $"/issue/{issueId.ToString(CultureInfo.InvariantCulture)}/{status.ToLowerInvariant()}",
+            null,
+            cancellationToken,
+            userId.Value).ConfigureAwait(false);
+    }
