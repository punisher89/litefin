+    /// <summary>Creates a Seerr issue using Seerr's internal Media ID, not a TMDB ID.</summary>
+    [HttpPost("Issues")]
+    public async Task<IActionResult> CreateIssue([FromBody] JsonElement request, CancellationToken cancellationToken)
+    {
+        if (request.ValueKind != JsonValueKind.Object
+            || !request.TryGetProperty("mediaId", out var mediaIdValue)
+            || !mediaIdValue.TryGetInt32(out var mediaId)
+            || mediaId <= 0
+            || !request.TryGetProperty("issueType", out var issueTypeValue)
+            || !issueTypeValue.TryGetInt32(out var issueType)
+            || issueType is < 1 or > 4
+             || !request.TryGetProperty("message", out var messageValue)
+            || messageValue.ValueKind != JsonValueKind.String
+            || string.IsNullOrWhiteSpace(messageValue.GetString()))
+        {
+            return this.BadRequest(new { message = "A valid Seerr media ID, issue type and description are required." });
+        }
+
+        var userId = await this.ResolveAuthenticatedSeerrUserIdAsync(cancellationToken).ConfigureAwait(false);
+        if (!userId.HasValue)
+        {
+            return this.StatusCode(StatusCodes.Status403Forbidden, new { message = "This Jellyfin user is not linked to Seerr." });
+        }
+
+        const int createIssues = 4194304;
+        const int manageIssues = 1048576;
+        if (!await this.HasSeerrPermissionAsync(userId.Value, createIssues | manageIssues, cancellationToken).ConfigureAwait(false))
+        {
+            return this.StatusCode(StatusCodes.Status403Forbidden, new { message = "Seerr CREATE_ISSUES permission is required." });
+        }
+
+        var problemSeason = request.TryGetProperty("problemSeason", out var seasonValue) && seasonValue.TryGetInt32(out var season)
+            ? Math.Max(0, season)
+            : 0;
+        var problemEpisode = request.TryGetProperty("problemEpisode", out var episodeValue) && episodeValue.TryGetInt32(out var episode)
+            ? Math.Max(0, episode)
+            : 0;
+        var payload = new Dictionary<string, object>
+        {
+            ["mediaId"] = mediaId,
+            ["issueType"] = issueType,
+            ["message"] = messageValue.GetString()!.Trim(),
+            ["problemSeason"] = problemSeason,
+            ["problemEpisode"] = problemSeason > 0 ? problemEpisode : 0,
+        };
+
+        return await this.ProxyAsync(HttpMethod.Post, "/issue", payload, cancellationToken, userId.Value).ConfigureAwait(false);
+    }
