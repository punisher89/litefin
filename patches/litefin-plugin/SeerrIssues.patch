+    /// <summary>Gets issue reports for the authenticated Seerr user.</summary>
+    [HttpGet("Issues")]
+    public async Task<IActionResult> GetIssues(
+        [FromQuery] int take = 20,
+        [FromQuery] int skip = 0,
+        [FromQuery] string filter = "open",
+        [FromQuery] string sort = "added",
+        CancellationToken cancellationToken = default)
+    {
+        var userId = await this.ResolveAuthenticatedSeerrUserIdAsync(cancellationToken).ConfigureAwait(false);
+        if (!userId.HasValue)
+        {
+            return this.StatusCode(StatusCodes.Status403Forbidden, new { message = "This Jellyfin user is not linked to Seerr." });
+        }
+
+        var normalizedFilter = filter is "all" or "open" or "resolved" ? filter : "open";
+        var normalizedSort = sort.Equals("modified", StringComparison.OrdinalIgnoreCase) ? "modified" : "added";
+        var path = $"/issue?take={Math.Clamp(take, 1, 100).ToString(CultureInfo.InvariantCulture)}"
+            + $"&skip={Math.Max(0, skip).ToString(CultureInfo.InvariantCulture)}"
+            + $"&filter={Uri.EscapeDataString(normalizedFilter)}"
+            + $"&sort={Uri.EscapeDataString(normalizedSort)}";
+
+        // Seerr applies the authenticated user's issue visibility rules using X-Api-User:
+        // regular users see their own reports; VIEW_ISSUES / MANAGE_ISSUES users can see more.
+        return await this.ProxyAsync(HttpMethod.Get, path, null, cancellationToken, userId.Value).ConfigureAwait(false);
+    }
